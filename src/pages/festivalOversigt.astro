---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<Layout>
<div class="festivaloversigt">
            <h1 class="festivaloversigt ">Festival oversigt</h1>
            <img src="/billeder/festivaloversigt.webp" alt="oversigt">
        </div>
        <div class="festivalprogram">


            <div class="blogen">
                 <h2 class="fredag">FREDAG 28. august:</h2>
              <h4>HOVEDSCENEN: BLØGEN</h4>
<div class="tidspunkt">
                    <h5>16:00 - 18:00</h5>
                    <h5>Spawner</h5>
                </div>
                <div class="tidspunkt">
                    <h5>18:30 - 20:30</h5>
                    <h5>Majke Voss</h5>
                </div>
                <div class="tidspunkt">
                    <h5>21:00 - 23:00</h5>
                    <h5>Miaw</h5>
                </div>


                <h4>SKOVSCENEN: EKKO</h4>
                <div class="tidspunkt">
                    <h5>16:00 - 18:00</h5>
                    <h5>Boko Yout (S)</h5>
                </div>
                <div class="tidspunkt">
                    <h5>18:30 - 20:30</h5>
                    <h5>Torben Laks</h5>
                </div>
                <div class="tidspunkt">
                    <h5>21:00 - 23:00</h5>
                    <h5>School of X</h5>
                </div>
            </div>


            <div class="ekko">
                <h2 class="lordagmobil">LØRDAG 29. august:</h2>
              <h4>HOVEDSCENEN: BLØGEN</h4>
               

                <div class="tidspunkt">

                    <h5>17:00 - 19:00</h5>
                    <h5>Papa Bues Viking Jazzband</h5>
                </div>
                <div class="tidspunkt">
                    <h5>19:30 - 21:30</h5>
                    <h5>Lars & momsregnskabet</h5>
                </div>
                <div class="tidspunkt">
                    <h5>22:00 - 24:00</h5>
                    <h5>Chardonnaderne</h5>
                </div>


                <h4>SKOVSCENEN: EKKO</h4>
                <div class="tidspunkt">
                    <h5>17:00 - 19:00</h5>
                    <h5>De tabte småkager</h5>
                </div>
                <div class="tidspunkt">
                    <h5>19:30 - 21:30</h5>
                    <h5>Malmelade sluperne</h5>
                </div>
                <div class="tidspunkt">
                    <h5>22:00 - 24:00</h5>
                    <h5>Snuggle</h5>
                </div>
            </div>

        </div>
</Layout>
<style>
@media (max-width: 768px) {
  .festivalprogram {
    display: flex;
    flex-direction: column;
    padding: 30px;
  }
.festivalprogram h2 {
    margin-top: 30px;
  }

  .ekkodesktop {
    display: none;
  }
}

.festivalprogram {
  max-width: 430px;
  margin: 0 auto;
}

.festivaloversigt {
 text-align: center;
 }

.festivaloversigt img {
  width: 100%;
}


.lordagmobil{
  color:#873000;
 }


.fredag {
  display: flex;
  flex-direction: column;
  order: -1;
  color: #873000;
}

.tidspunkt {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 12px;
}

@media (min-width: 1024px) {
  .festivaloversigt img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .festivalprogram {
    max-width: 1000px;
    padding: 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .tidspunkt {
    grid-template-columns: 1fr 2fr;
 
  }
}
</style>