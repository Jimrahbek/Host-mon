---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<Layout>
<div class="festivaloversigt">
            <h1 class="festivaloversigt ">Festival oversigt</h1>
            <img src="/public/billeder/festivaloversigt.webp" alt="oversigt">
        </div>
        <div class="festivalprogram">


            <div class="blogen">
                 <h2 class="fredag">FREDAG 28. august:</h2>
              <h2>HOVEDSCENEN: BLØGEN</h2>
<div class="tidspunkt">
                    <p>16:00 - 18:00</p>
                    <p>Spawner</p>
                </div>
                <div class="tidspunkt">
                    <p>18:30 - 20:30</p>
                    <p>Majke Voss</p>
                </div>
                <div class="tidspunkt">
                    <p>21:00 - 23:00</p>
                    <p>Miaw</p>
                </div>


                <h2 class="ekkomobil">SKOVSCENEN: EKKO</h2>
                <div class="tidspunkt">
                    <p>16:00 - 18:00</p>
                    <p>Boko Yout (S)</p>
                </div>
                <div class="tidspunkt">
                    <p>18:30 - 20:30</p>
                    <p>Torben Laks</p>
                </div>
                <div class="tidspunkt">
                    <p>21:00 - 23:00</p>
                    <p>School of X</p>
                </div>
            </div>


            <div class="ekko">
                <h2 class="lordagmobil">LØRDAG 29. august:</h2>
              <h2 class="ekkodesktop">HOVEDSCENEN: BLØGEN</h2>
               

                <div class="tidspunkt">

                    <p>17:00 - 19:00</p>
                    <p>Papa Bues Viking Jazzband</p>
                </div>
                <div class="tidspunkt">
                    <p>19:30 - 21:30</p>
                    <p>Lars & momsregnskabet</p>
                </div>
                <div class="tidspunkt">
                    <p>22:00 - 24:00</p>
                    <p>Chardonnaderne</p>
                </div>


                <h2 class="ekkodmobil1">SKOVSCENEN: EKKO</h2>
                <div class="tidspunkt">
                    <p>17:00 - 19:00</p>
                    <p>De tabte småkager</p>
                </div>
                <div class="tidspunkt">
                    <p>19:30 - 21:30</p>
                    <p>Malmelade sluperne</p>
                </div>
                <div class="tidspunkt">
                    <p>22:00 - 24:00</p>
                    <p>Snuggle</p>
                </div>
            </div>

        </div>
</Layout>
<style>
@media (max-width: 768px) {
  .festivalprogram {
    display: flex;
    flex-direction: column;
    padding: 30px;
  }

  .blogen,
  .ekko {
    display: contents;
  }

 

  .lordag {
    display: none;
    margin-top: 30px;
  }

  

  .festivalprogram h2 {
    margin-top: 30px;
  }

  .ekkodesktop {
    display: none;
  }
}

.festivalprogram {
  max-width: 430px;
  margin: 0 auto;
}

.festivaloversigt {
 text-align: center;
 }

.festivaloversigt img {
  width: 100%;
}


.lordagmobil{
  color:#873000;
 }
.fredag17 {
  display: none;
}

.fredag {
  display: flex;
  flex-direction: column;
  order: -1;
  color: #873000;
}



.tidspunkt {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 12px;
}

@media (min-width: 1024px) {
  .festivaloversigt img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .festivalprogram {
    max-width: 1000px;
    padding: 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .tidspunkt {
    grid-template-columns: 1fr 2fr;
  
  }

  .fredag17 {
    display: block;
  }

  

  .blogenmobil {
    display: none;
  }

  
}
</style>