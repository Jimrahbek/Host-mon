---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<layout>
</layout>
<body>
    <main>
        <div class="festivaloversigt">
            <h1 class="festivaloversigt ">Festival oversigt</h1>
            <img src="/img/festivaloversigt.webp" alt="oversigt">
        </div>
        <div class="festivalprogram">


            <div class="blogen">
                <h1>HOVEDSCENEN: BLØGEN</h1>

                <h2 class="fredag">FREDAG 28. august:</h2>
                <div class="tidspunkt">
                    <p>16:00 - 18:00</p>
                    <p>Spawner</p>
                </div>
                <div class="tidspunkt">
                    <p>18:30 - 20:30</p>
                    <p>Majke Voss</p>
                </div>
                <div class="tidspunkt">
                    <p>21:00 - 23:00</p>
                    <p>Miaw</p>
                </div>

                <h2>LØRDAG 29. august:</h2>
                <div class="tidspunkt">
                    <p>16:00 - 18:00</p>
                    <p>Boko Yout (S)</p>
                </div>
                <div class="tidspunkt">
                    <p>18:30 - 20:30</p>
                    <p>Torben Laks</p>
                </div>
                <div class="tidspunkt">
                    <p>21:00 - 23:00</p>
                    <p>School of X</p>
                </div>
            </div>


            <div class="ekko">
                <h1>SKOVSCENEN: EKKO</h1>

                <h2 class="fredag17">FREDAG 28. august:</h2>
                <div class="tidspunkt">
                    <p>17:00 - 19:00</p>
                    <p>Papa Bues Viking Jazzband</p>
                </div>
                <div class="tidspunkt">
                    <p>19:30 - 21:30</p>
                    <p>Lars & momsregnskabet</p>
                </div>
                <div class="tidspunkt">
                    <p>22:00 - 24:00</p>
                    <p>Chardonnaderne</p>
                </div>

                <h2 class="lordag17">LØRDAG 29. august:</h2>
                <div class="tidspunkt">
                    <p>17:00 - 19:00</p>
                    <p>De tabte småkager</p>
                </div>
                <div class="tidspunkt">
                    <p>19:30 - 21:30</p>
                    <p>Malmelade sluperne</p>
                </div>
                <div class="tidspunkt">
                    <p>22:00 - 24:00</p>
                    <p>Snuggle</p>
                </div>
            </div>

        </div>
    </main>
</body>
<footer>
    <p class="fortvej">Fortvej 8, 4760, Vordingborg</p>
    <p class="infohost">info@hoestmoen.dk</p>
</footer>






</html>
<style>
    .festivalprogram {
  max-width: 430px;
  margin: 0 auto;
}
body {
  background-color: #dae6cb;
  margin: 0;
  padding: 0;
}
footer {
  background-color: #00393e;
  color: #dae6cb;
  font-family: "Source Sans 3", sans-serif;
}
.festivaloversigt {
  font-size: 20px;
  text-align: center;
  font-family: "Covered By Your Grace", sans-serif;
}
p {
  font-family: "Mochiy Pop One", sans-serif;
}
.festivaloversigt img {
  width: 100%;
}
.fredag17 {
  display: none;
}
.lordag17 {
  display: none;
}
.festivalprogram h2 {
  color: #a03900;
  font-family: "Mochiy Pop One", sans-serif;
}
.festivalprogram h1 {
  font-family: "Covered By Your Grace", sans-serif;
}

.tidspunkt {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 8px;
}

@media (min-width: 1024px) {
  .festivaloversigt img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .festivaloversigt {
    font-size: 64px;
    text-align: center;
    font-family: "Covered By Your Grace", sans-serif;
  }
  .festivalprogram {
    max-width: 1000px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  .festivalprogram h1,
  .festivalprogram h2 {
    grid-column: 1 / -1;
  }
  .tidspunkt {
    display: grid;
    grid-template-columns: 1fr 2fr;
  }
  .fredag17 {
    display: block;
  }
  .lordag17 {
    display: block;
  }
}

</style>