---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";
import Artister from "../components/Artister.astro";

const url =`${import.meta.env.SUPABASE_URL}/rest/v1/Artister?select=*`;
const apiKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey,
  },
};

const data = await fetch(url, options)
  .then((res) => res.json());

console.log(data);
---

<Layout>


  {data.map((artister) => <Artister artister={artister} />)}

</Layout>