---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<Layout>
   <h1 class="arkiv">Arkiv
        </h1>
        <h2 class="underskrift">Se hvilke artister vi har haft glæde af til tidligere arrangmenter</h2>
        <div class="grid">
            <div class="arstal">

                <h2 class="arkivtal">2024</h2>
                <img src="/public/billeder/billede1.webp" alt="billede1">
            </div>

            <div class="arstal">
                <h2 class="arkivtal">2023</h2>
                <img src="/public/billeder/billede2.webp" alt="billede2">
            </div>
            <div class="arstal">
                <h2 class="arkivtal">2022</h2>
                <img src="/public/billeder/billede3.webp" alt="billede3">
            </div>
            <div class="arstal21-19">
                <h2 class="arkivtal">2021</h2>
                <img src="/public/billeder/billede4.webp" alt="billede4">
            </div>
            <div class="arstal21-19">
                <h2 class="arkivtal">2019</h2>
                <img src="/public/billeder/billede5.webp" alt="billede5">
            </div>
            <div class="arstal21-19">
                <h2 class="arkivtal">2018</h2>
                <img src="/public/billeder/billede6.webp" alt="billede6">
            </div>
        </div>
</Layout>
<style>
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 90px;

}

.underskrift {
  
  text-align: center;
  max-width: 450px;
  margin: 0 auto 20px auto;
}
.arkiv {
  padding: 5px;
  text-align: center;
  
  
}

img {
  max-width: 150px;
  height: auto;
}
.arstal h2,
.arstal21-19 h2 {
  margin: 0 0 10px 0;
}



.arstal {
  display: flex;
  flex-direction: column;
  align-items: center;
  
  
}

.arstal21-19 {
  display: flex;
  flex-direction: column;
  align-items: center;
 
  
}

@media (min-width: 1024px) {
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 90px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 90px;
  }
  .underskrift {
    max-width: 520px;
  }
  img {
    width: 100%;
    max-width: 300px;
    padding: 5px;
  }

 
  .arkiv {
    text-align: center;
    }
  .underskrift{
     
  max-width: 1024px;
  
}
  
  
}
</style>
    