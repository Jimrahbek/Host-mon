---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<Layout>
   <h1 class="arkiv">Arkiv
        </h1>
        <h3 class="underskrift">Se hvilke artister vi har haft glæde af til tidligere arrangmenter</h3>
        <div class="grid">
            <div class="arstal">

                <h1>2024</h1>
                <img src="/public/billeder/billede1.webp" alt="billede1">
            </div>

            <div class="arstal">
                <h1>2023</h1>
                <img src="/public/billeder/billede2.webp" alt="billede2">
            </div>
            <div class="arstal">
                <h1>2022</h1>
                <img src="/public/billeder/billede3.webp" alt="billede3">
            </div>
            <div class="arstal21-19">
                <h1>2021</h1>
                <img src="/public/billeder/billede4.webp" alt="billede4">
            </div>
            <div class="arstal21-19">
                <h1>2019</h1>
                <img src="/public/billeder/billede5.webp" alt="billede5">
            </div>
            <div class="arstal21-19">
                <h1>2018</h1>
                <img src="/public/billeder/billede6.webp" alt="billede6">
            </div>
        </div>
</Layout>
<style>
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  padding: 0 20px;
}
body {
  background-color: #dae6cb;
  margin: 0;
}
.underskrift {
 text-align: center;
  max-width: 350px;
  margin: 0 auto 20px auto;
}
.arkiv {
  padding: 5px;
  text-align: center;
  
}

img {
  max-width: 150px;
  height: auto;
}
.arstal h2,
.arstal21-19 h2 {
  margin: 0 0 10px 0;
}


.arstal {
  display: flex;
  flex-direction: column;
  align-items: center;
  
}

.arstal21-19 {
  display: flex;
  flex-direction: column;
  align-items: center;
 
}



@media (min-width: 1024px) {
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 90px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 70px;
  }
  .underskrift {
    max-width: 520px;
  }
  img {
    width: 100%;
    max-width: 300px;
    padding: 5px;
  }
  footer {
    width: 100%;
    margin-top: 40px;
  }
  .fortvej {
    padding: 10px;
  }
  .infohost {
    margin: 0 auto;
    right: 20%;
  }
  .arkiv {
    text-align: center;
    }
 
}
</style>
    