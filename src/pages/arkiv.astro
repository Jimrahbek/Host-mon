---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";

---
<layout>
</layout>
    <body>
    <main>
        <h1 class="arkiv">Arkiv
        </h1>
        <h3 class="underskrift">Se hvilke artister vi har haft glæde af til tidligere arrangmenter</h3>
        <div class="grid">
            <div class="arstal">

                <h2>2024</h2>
                <img src="/img/billede1.webp" alt="billede1">
            </div>

            <div class="arstal">
                <h2>2023</h2>
                <img src="/img/billede2.webp" alt="billede2">
            </div>
            <div class="arstal">
                <h2>2022</h2>
                <img src="/img/billede3.webp" alt="billede3">
            </div>
            <div class="arstal21-19">
                <h2>2021</h2>
                <img src="/img/billede4.webp" alt="billede4">
            </div>
            <div class="arstal21-19">
                <h2>2019</h2>
                <img src="/img/billede5.webp" alt="billede5">
            </div>
            <div class="arstal21-19">
                <h2>2018</h2>
                <img src="/img/billede6.webp" alt="billede6">
            </div>
        </div>
    </main>
    <footer>
        <p class="fortvej">Fortvej 8, 4760, Vordingborg</p>
        <p class="infohost">info@hoestmoen.dk</p>
    </footer>
</body>

</html>

<style>
   .grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
body {
  background-color: #dae6cb;
  margin: 0;
}
.underskrift {
  font-family: "Mochiy Pop One";
  font-size: 24px;
  font-style: normal;
  font-weight: 400;
  width: 310px;
  height: 111px;
  margin: auto;
}
.arkiv {
  padding: 5px;
  text-align: center;
  color: #a03900;
  font-size: 40px;
  font-family: "Covered By Your Grace", cursive;
}

img {
  width: 80%;
  position: relative;
}
h1,
h2 {
  line-height: 1.1;
}
footer {
  background-color: #00393e;
  width: 500px;
  height: 83px;
}

.arstal {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 64px;
  font-family: "Covered By Your Grace", cursive;
}

.arstal21-19 {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 64px;
  font-family: "Covered By Your Grace", cursive;
}

.fortvej {
  color: #dae6cb;
  font-family: "Source Sans 3", sans-serif;
}

.infohost {
  color: #dae6cb;
  font-family: "Source Sans 3", sans-serif;
}

@media (min-width: 1024px) {
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  footer {
    background-color: #00393e;
  }

  .arkiv {
    text-align: center;
    color: #a03900;
    font-size: 40px;
    font-family: "Covered By Your Grace", cursive;
  }
  .arstal {
    margin: 20px;
  }
} 
</style>