---
import Layout from "../../layouts/Layout.astro";
import Artister from "../../components/Artister.astro";

export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.SUPABASE_URL}/rest/v1/Artister?select=*`, {
    headers: {
      apikey: import.meta.env.SUPABASE_PUBLISHABLE_KEY
    }
  });

  const data = await res.json();

  return data.map((artist: any) => ({
    params: { id: artist.id.toString() },
    props: { artist }
  }));
}

const { artist } = Astro.props;
---

<Layout>
  <Artister artister={artist} />
</Layout>