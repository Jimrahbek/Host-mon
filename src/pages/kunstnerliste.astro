---
import Layout from "../layouts/Layout.astro";
import artistliste from "../components/artisterliste.astro";

const url = `${import.meta.env.SUPABASE_URL}/rest/v1/Artister?select=*`;
const apiKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey
  }
};

const data = await fetch(url, options).then(res => res.json());
---

<Layout>
    <div class="title">
      <h1>Lineup</h1>
      <p class="info">På Høst Møn kan du opleve stemningsfulde koncerter, nærværende musikoplevelser, hyggelige fællesskaber og spændende kunstnere både etablerede navne og nye talenter – samlet i de smukke omgivelser på Møn.
Vi offentliggør hermed programmet for Høst Møn 2026. Se hvilke artister og oplevelser, du allerede nu kan begynde at glæde dig til her</p>
</div>

<div class="timeline">
  {data.map((artist: any) => (
    <a href={`/kunstnere/${artist.id}`} class="item">
      <img src={`/${artist.billede}`} alt="" />
      <h2 class="pad">{artist.navn}</h2>
    </a>
  ))}
</div>
</Layout>

    <style>
.pad{
    padding-top: 10%;
     padding-left: 10%;
}

.title{
  display: flex;              
  flex-direction: column;
  align-items: center;        
  text-align: center; 
}

.timeline {
    display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10%;
  flex-direction: column;
  align-items: center; 
}

.info{
    padding-left: 5%;
    padding-right: 5%;
}

.timeline img {
  width: 100%;
  max-width: 800px;   
  height: auto;
  display: block;
}

/* mobile */
@media (max-width: 768px) {
  .timeline {
    grid-template-columns: 1fr;
    gap: 2%;
  }
}
    </style>