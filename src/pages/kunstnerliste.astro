---
import Layout from "../layouts/Layout.astro";
import artistliste from "../components/artisterliste.astro";

const url = `${import.meta.env.SUPABASE_URL}/rest/v1/Artister?select=*`;
const apiKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey
  }
};

const data = await fetch(url, options).then(res => res.json());
---

<Layout>
    <div class="luft">
    <div class="title">
      <h1>Lineup</h1>
      <p class="info">På Høst Møn kan du opleve stemningsfulde koncerter, nærværende musikoplevelser, hyggelige fællesskaber og spændende kunstnere både etablerede navne og nye talenter – samlet i de smukke omgivelser på Møn.
Vi offentliggør hermed programmet for Høst Møn 2026. Se hvilke artister og oplevelser, du allerede nu kan begynde at glæde dig til her</p>
</div>

<div class="timeline">
  {data.map((artist: any) => (
    <a href={`/kunstnere/${artist.id}`} class="item">
        <div class="img-wrapper">
    <img src={`/${artist.billede}`} alt="" />
  </div>
      <h1 class="pad">{artist.navn}</h1>
    </a>
  ))}
</div>
</div>
</Layout>

    <style>
.item{
      text-decoration: none;
  color: inherit;
}

.img-wrapper {
  height: 300px;
  display: flex;
  align-items: flex-end;
  overflow: hidden; 
}
.img-wrapper img {
  max-height: 100%;  
  width: auto;
  max-width: 100%;
  display: block;
}

.luft{
    padding-left: 5%;
    padding-right: 5%;
}

.pad{
    padding-top: 10px;
     padding-left: 30px;     
}

.title{
  display: flex;              
  flex-direction: column;
  align-items: center;        
  text-align: center; 
}

.timeline {
    display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  flex-direction: column;
  align-items: center; 
}

.info{
    padding-left: 5%;
    padding-right: 5%;
    width: 40%;
}

.timeline img {
  width: 100%;
  max-width: 800px;   
  height: auto;
  display: block;
}

/* mobile */
@media (max-width: 768px) {
  .timeline {
    grid-template-columns: 1fr;
    gap: 2%;
  }
  .info{
    padding-left: 5%;
    padding-right: 5%;
    width: 80%;
}
}
    </style>