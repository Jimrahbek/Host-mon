---
import Layout from "../layouts/Layout.astro";
import artistliste from "../components/artisterliste.astro";

const url = `${import.meta.env.SUPABASE_URL}/rest/v1/Artister?select=*`;
const apiKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey
  }
};

const data = await fetch(url, options).then(res => res.json());
---

<Layout>
  <section class="lineup-page">
    <div class="lineup-header">
      <h1>Line-up for 2026</h1>
      <p class="info">
        På Høst Møn kan du opleve stemningsfulde koncerter, nærværende musikoplevelser,
        hyggelige fællesskaber og spændende kunstnere – både etablerede navne og nye
        talenter – samlet i de smukke omgivelser på Møn.
      </p>
      <p class="info">
        Vi offentliggør hermed programmet for Høst Møn 2026. Se hvilke artister og
        oplevelser, du allerede nu kan begynde at glæde dig til her
      </p>
    </div>

    <div class="timeline">
      {data.map((artist: any) => (
        <a href={`/kunstnere/${artist.id}`} class="item">
          <div class="img-wrapper">
            <img src={`/${artist.billede}`} alt={artist.navn} />
          </div>
          <h3 class="artist-name">{artist.navn}</h3>
        </a>
      ))}
    </div>
  </section>
</Layout>

    <style>
.lineup-page {
  width: min(1120px, calc(100% - 3rem));
  margin: 0 auto;
  padding: 1.5rem 0 4rem;
}

.lineup-header {
  max-width: 520px;
  margin: 0 auto 3rem;
  text-align: center;
}

.lineup-header h1 {
  margin: 0 0 1rem;
}

.info {
  margin: 0;
  font-size: 1rem;
  line-height: 1.65;
}

.info + .info {
  margin-top: 0.75rem;
}

.timeline {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 3rem;
  row-gap: 2.5rem;
  align-items: start;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;   /* <-- vigtig */
  text-decoration: none;
  color: inherit;
}

.img-wrapper {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-wrapper img {
  display: block;
  width: min(100%, 260px);
  height: auto;
  object-fit: contain;
}

.artist-name {
  margin: 1rem 0 0;
  font-family: "Covered By Your Grace", cursive;
  font-size: clamp(2rem, 3vw, 3rem);
  font-weight: 400;
  line-height: 1;
  text-align: left;
}

@media (max-width: 768px) {
  .lineup-page {
    width: min(100%, calc(100% - 1.5rem));
    padding: 1rem 0 3rem;
  }

  .lineup-header {
    max-width: 100%;
    margin-bottom: 2rem;
  }

  .timeline {
    grid-template-columns: 1fr 1fr;
    column-gap: 1.5rem;
    row-gap: 2rem;
  }

  .img-wrapper img {
    width: min(100%, 220px);
  }

  .artist-name {
    font-size: clamp(1.7rem, 5vw, 2.3rem);
    margin-top: 0.75rem;
  }
}
    </style>