---
// @ts-nocheck
const { artister } = Astro.props;

function formatSpilletid(value) {
  if (!value) return "";

  let dateString = value;
  if (typeof dateString === "string" && dateString.includes(" ") && !dateString.includes("T")) {
    dateString = dateString.replace(" ", "T");
  }

  const date = new Date(dateString);
  if (Number.isNaN(date.getTime())) return value;

  const day = date.getDate();
  const month = date.toLocaleString("da-DK", { month: "long" });
  const hours = String(date.getHours()).padStart(2, "0");
  const minutes = String(date.getMinutes()).padStart(2, "0");

  return `${day}. ${month} kl ${hours}:${minutes}`;
}
---
<div class="style">
<div class="content-left">
<img class="pic" src={`/${artister.billede}`} alt="">
</div>
<div class="content-right">
<img class="navn" src={`/${artister.navnSvg}`} alt="" />
<img class="pic-mobile" src={`/${artister.billede}`} alt="">
<h2>{formatSpilletid(artister.spilletid)}</h2>
<p>{artister.artistbeskrivelse}</p>
<h3>{artister.overskrift}</h3>
<a href={artister.spotify}target="_blank" >
  <img src="/billeder/spotify.svg" alt="spotify">
  <a href={artister.instagram}target="_blank" >
  <img src="/billeder/instagram.svg" alt="spotify">
</a>
</div>
</div>
<style>
.style img.pic {
  width: 100%;
  max-width: 800px;   
  height: auto;
  display: block;
}

.pic-mobile {
  display: none;
}

.style{
        display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10%;
  flex-direction: column;
  align-items: center; 
  padding-left: 5%;
  padding-right: 5%;
}


/* mobile */
@media (max-width: 768px) {
  .style {
    grid-template-columns: 1fr;
    gap: 2%;
  }

  .content-left {
    display: none;
  }

  .pic-mobile {
    display: block;
    width: 100%;
    max-width: 800px;   
    height: auto;
  }

  .navn{
    padding-left: 10%;
  }
}

</style>