---
import "../style/global.css"
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
 <header class="topbar">
        <div class="logo">
            <img src="billeder/670282915_3785650628231726_4077932530482168911_n.png" alt="Høst Møn">
        </div>

        <div class="burger" id="burger-toggle">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </header>

    <div class="burger-menu" id="burger-menu">

        <div class="close-btn" id="close-menu">✕</div>

        <div class="burger-logo-wrap">
            <img src="billeder/670282915_3785650628231726_4077932530482168911_n.png" alt="Høst Møn" class="burger-logo">
        </div>
        <nav class="burger-nav">
            <div class="burger-link">
                <a href="/om_host_mon" class="burger-title">Om høst møn</a>
                <a href="/om_host_mon" class="burger-arrow">→</a>
            </div>

            <div class="burger-link">
                <a href="/kunstnerliste" class="burger-title">Program</a>
                <a href="/kunstnerliste" class="burger-arrow">→</a>
            </div>

            <div class="burger-link">
                <a href="/kobsOversigt" class="burger-title">Køb billet</a>
                <a href="/kobsOversigt" class="burger-arrow">→</a>
            </div>

            <div class="burger-link">
                <a href="/festivalOversigt" class="burger-title">Festival oversigt </a>
                <a href="/festivalOversigt" class="burger-arrow">→</a>
            </div>

            <div class="burger-link">
                <a href="/maaltidet" class="burger-title">Menu </a>
                <a href="/maaltidet" class="burger-arrow">→</a>
            </div>

            <div class="burger-link">
                <a href="/arkiv" class="burger-title">Arkiv</a>
                <a href="/arkiv" class="burger-arrow">→</a>
            </div>
        </nav>

        <div class="burger-contact">
            <a href="mailto:INFO@HOESTMOEN.DK" class="contact-mail">INFO@HOESTMOEN.DK</a>
            <p>Masnedøfortet, 4760 Vordingborg.</p>

            <div class="social-block">
                <div class="find-os">Find os her</div>

                <div class="social-icons">
                    <a href="#" aria-label="Instagram">
                        <img src="ikoner/instagram.svg" alt="Instagram">
                    </a>
                    <a href="#" aria-label="Facebook">
