                    </a>
                </div>
            </div>
        </div>
    </div>

    <main>
      <slot />
    </main>

    <footer>
      <p class="footer_adresse">Fortvej 8, 4760, Vordingborg.</p>
      <div class="footer_social_media">

       <a href="https://www.facebook.com/hoestmoen">
       <img src="img/FB.png"> </a>

        <a href="https://www.instagram.com/hoestmoen/"> <img src="img/IG.png"></a>
      </div>
      <p class="footer_mail">info@hoestmoen.dk</p>
    </footer>
  </body>
</html>
<script>

</script>


<style>
footer {
  width: min(1200px, 100%);
  margin-inline: auto;
}


/*********************** Footer *****************/
footer {
  background-color: var(--color-primary);
  text-align: center;
  padding: 1rem;
  width: 100%;
  color: var(--color-text-light);
  text-decoration: none;
}

/************  Footer *************/
footer {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  justify-content: space-between;
  text-align: center;
  background-color: var(--color-primary);
  width: 100%;
}

.footer_adresse {
  text-align: bottom;
  justify-self: right;
  padding: 0, 5rem;
  color: var(--color-text-light);
}

.footer_social_media {
  text-align: bottom;
  justify-self: center;
  padding: 1rem;
  width: 100%;
  color: var(--color-text-light);
}

.footer_mail {
  text-align: bottom;
  justify-self: left;
  padding: 0, 5rem;
  color: var(--color-text-light);
}

	body {
  margin: 0;
  background-color: #c8d2bd;
}
body.menu-open {
  overflow: hidden;
}
.burger-logo {
  width: 210px;
}
.logo img {
  height: 50px;
  width: auto;
  display: block;
}
.burger-logo-wrap {
  display: flex;
  justify-content: center; 
  align-items: center; 
  padding: 60px 0 40px;
  width: 100%;
}
/* TOPBAR */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between; 
  padding: 18px 24px;
}
.burger-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 10px 18px 36px;
  border-top: 1px solid rgba(0, 0, 0, 0.15);
  font-family: "Source Sans 3", sans-serif;
}

.burger-link:last-child {
  border-bottom: 1px solid rgba(0, 0, 0, 0.15);
}

.burger-title {
  text-decoration: none;
  color: #000;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.2;
}

.burger-arrow {
  width: 42px;
  height: 42px;
  min-width: 42px;
  border-radius: 50%;
  background-color: #a64000;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  text-decoration: none;
}
.burger {
  width: 40px;
  height: 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  cursor: pointer;
}

.burger span {
  display: block;
  width: 100%;
  height: 3px;
  background-color: #000;
  border-radius: 50px;
}

/* SIDEMENU */
.burger-menu {
  position: fixed;
  top: 0;
  right: -100%; 
  width: 100%; 
  height: 100vh;
  background-color: #c8d2bd;
  z-index: 9999;
  transition: right 0.4s ease;
  overflow-y: auto;

  display: flex;
  flex-direction: column;
}

.burger-menu.active {
  right: 0; 
}

.burger-nav {
  padding-top: 24px;
}
.close-btn {
  position: absolute;
  top: 18px;
  right: 20px;
  font-size: 28px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.burger-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 10px 18px 36px;
  text-decoration: none;
  color: #000;
  border-top: 1px solid rgba(0, 0, 0, 0.15);
  font-family: "Source Sans 3", sans-serif;
}

.burger-link:last-child {
  border-bottom: 1px solid rgba(0, 0, 0, 0.15);
}

.burger-link span {
  font-size: 24px;
  font-weight: 700;
  line-height: 1.2;
}

.burger-arrow {
  width: 42px;
  height: 42px;
  min-width: 42px;
  border-radius: 50%;
  background-color: #a64000;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

/* KONTAKTOMRÅDE */
.burger-contact {
  text-align: center;
  padding: 50px 20px 60px;
}

.contact-mail {
  display: inline-block;
  color: #000;
  font-size: 18px;
  margin-bottom: 24px;
  text-transform: uppercase;
  font-family: "Source Sans 3", sans-serif;
}

.burger-contact p {
  margin: 0 0 28px;
  font-size: 17px;
  font-family: "Source Sans 3", sans-serif;
  color: #000;
}

.social-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  margin-top: 10px;
}

.find-os {
  font-size: 18px;
  margin: 0;
  color: #000;
  font-family: "Source Sans 3", sans-serif;
}

.social-icons {
  display: flex;
  justify-content: center;
  gap: 14px;
}

.social-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.social-icons img {
  width: 36px;
  height: 36px;
  object-fit: contain;
}

.forsidebilledeogh1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80px;
}

@media (max-width: 768px) {
  .sektion {
    flex-direction: column;
    text-align: center;
  }
  .sektiontekst {
    margin-left: 0;
    max-width: none;
  }
  .lineupsektion {
    background-color: #00393e;
    padding: 30px 20px 40px 20px;
  }

  .lineup {
    text-align: center;
    margin: 0 0 20px 0;
  }

  .lineup h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.2;
    color: white;
  }

  .lineupbilleder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .lineupbilleder img:first-child {
    width: 300px;
    height: auto;
    order: 1;
  }

  .lineupbilleder img:last-child {
    width: 300px;
    height: auto;
    order: 3;
    align-self: flex-end;
    margin-right: 20px;
    margin-top: -10px;
  }

  .lineupbilledenederst {
    display: flex;
    justify-content: flex-start;
    margin-top: -200px;
  }

  .lineupbilledenederst img {
    width: 300px;
    height: auto;
    margin: 0;
    margin-left: 10px;
    margin-top: 0; 
  }
}

</style>

   <script>
  const burgerToggle = document.getElementById("burger-toggle");
  const burgerMenu = document.getElementById("burger-menu");
  const closeBtn = document.getElementById("close-menu");

  if (burgerToggle && burgerMenu) {
    burgerToggle.addEventListener("click", () => {
      burgerMenu.classList.toggle("active");
    });
  }

  if (closeBtn && burgerMenu) {
    closeBtn.addEventListener("click", () => {
      burgerMenu.classList.remove("active");
    });
  }
</script>